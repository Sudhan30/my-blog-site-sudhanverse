---
import {CATEGORY_META} from '../../server/lib/posts';
import {fmtFull, readingTime, type PostSummary} from '../lib/site';

interface Props {
  posts: PostSummary[];
}

const {posts} = Astro.props;
---
{posts.length > 0 && (
  <section class="related-section" aria-labelledby="related-heading">
    <div class="related-head">
      <h2 id="related-heading" class="related-title">Continue reading</h2>
      <a href="/#latest" class="section-link">Full archive →</a>
    </div>
    <ul class="related-grid">
      {posts.map(post => (
        <li class="related-card">
          <a href={`/post/${post.slug}`} class="related-card-link">
            <div class="related-meta">
              <span class="row-category">{CATEGORY_META[post.category].shortLabel}</span>
              <span><time datetime={post.date}>{fmtFull(post.date)}</time> · {readingTime(post)} min</span>
            </div>
            <h3 class="related-card-title">{post.title}</h3>
            <p class="related-card-excerpt">{post.excerpt}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}
