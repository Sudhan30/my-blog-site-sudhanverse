---
import Base from '../layouts/Base.astro';
import Icon from './Icon.astro';
import PostCard from './PostCard.astro';
import {ArchiveTrail, ArchiveEmpty} from './react/ArchiveNavigation';
import {CATEGORY_META, getPostIndex, getPostsByCategory, type PostCategory} from '../../server/lib/posts';
import {getAllPostStats} from '../../server/routes/api';
import {CATEGORY_ICON} from '../lib/site';
interface Props { category: PostCategory }
const {category} = Astro.props;
const [posts, index, stats] = await Promise.all([getPostsByCategory(category), getPostIndex(), getAllPostStats()]);
const meta = CATEGORY_META[category];
const pillars = ['open-source', 'hackathon', 'engineering'] as const;
---
<Base title={meta.title} description={meta.description} url={`/category/${meta.slug}`}>
  <div class="container page">
    <header class="page-head">
      <ArchiveTrail label={meta.label} />
      <h1 class="page-title">{meta.title}</h1>
      <p class="page-lede">{meta.description}</p>
      <nav class="archive-pills" aria-label="Browse by category">
        <a href="/#latest">All writing <span class="pill-count">{index.posts.length}</span></a>
        {pillars.map(cat => (
          <a href={`/category/${CATEGORY_META[cat].slug}`} aria-current={cat === category ? 'page' : undefined}>
            <Icon name={CATEGORY_ICON[cat]} size={14} /> {CATEGORY_META[cat].label} <span class="pill-count">{index.categories[cat] || 0}</span>
          </a>
        ))}
      </nav>
    </header>
    {posts.length ? <ul class="card-grid">{posts.map(post => <PostCard post={post} stats={stats} />)}</ul> : <ArchiveEmpty title="No articles yet" description="Explore the other categories in the writing archive." />}
  </div>
</Base>
