---
import {Link} from '@astryxdesign/core/Link';
import {Stack} from '@astryxdesign/core/Stack';
import {Divider} from '@astryxdesign/core/Divider';
import {fmtFull, type PostSummary} from '../lib/site';
const {post} = Astro.props as {post: PostSummary};
const url = `/post/${post.slug}`;
const cover = post.poster || post.cover;
---
<section class="feature-story" aria-labelledby="feature-title">
  <div class="feature-copy">
    <p class="feature-date">Featured · <time datetime={post.date}>{fmtFull(post.date)}</time></p>
    <h2 id="feature-title"><a href={url}>{post.title}</a></h2>
    <p>{post.excerpt}</p>
    <div class="feature-actions">
      <Stack direction="horizontal" gap={4} wrap="wrap">
        <Link href={url}>Read article</Link>
        {post.video && <Link href={url + '#recording'}>Watch recording</Link>}
      </Stack>
    </div>
  </div>
  {cover && <img class="feature-poster" src={cover} alt="" width="1280" height="720" fetchpriority="high" />}
  <div class="feature-rule"><Divider /></div>
</section>
