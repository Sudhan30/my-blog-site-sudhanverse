---
import Icon from './Icon.astro';
import CategoryBadge from './CategoryBadge.astro';
import Engagement from './Engagement.astro';
import {fmtFull, readingTime, type PostSummary, type Stats} from '../lib/site';
interface Props { post: PostSummary; stats?: Stats; showCover?: boolean }
const {post, stats, showCover = false} = Astro.props;
const chips = post.highlights?.length ? post.highlights.slice(0, 3) : post.tags.slice(0, 4).map(t => `#${t}`);
---
<li class="post-row">
  <a href={`/post/${post.slug}`} class="post-row-link">
    <div class="post-row-main">
      <div class="card-meta">
        <CategoryBadge category={post.category} badge={post.badge} />
        <time datetime={post.date}>{fmtFull(post.date)}</time>
        <span>{readingTime(post)} min read</span>
      </div>
      <h3 class="card-title">{post.title} <Icon name="arrow-right" size={17} class="icon row-arrow" /></h3>
      <p class="card-excerpt">{post.excerpt}</p>
      <div class="card-foot">
        <ul class="chips">{chips.map(c => <li>{c}</li>)}</ul>
        <Engagement slug={post.slug} stats={stats} />
      </div>
    </div>
    {showCover && post.cover && <div class="post-row-cover" aria-hidden="true"><img src={post.cover} alt="" loading="lazy" /></div>}
  </a>
</li>
