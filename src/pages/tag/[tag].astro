---
import Base from '../../layouts/Base.astro';
import {ArchiveTrail, ArchiveEmpty} from '../../components/react/ArchiveNavigation';
import PostRow from '../../components/PostRow.astro';
import {getPostsByTag} from '../../../server/lib/posts';
import {getAllPostStats} from '../../../server/routes/api';

const tag = decodeURIComponent(Astro.params.tag || '');
const [posts, stats] = await Promise.all([getPostsByTag(tag), getAllPostStats()]);
---
<Base title={`Tag: ${tag}`} description={`Blog posts tagged with ${tag}`} url={`/tag/${encodeURIComponent(tag)}`}>
  <div class="container page">
    <header class="page-head">
      <ArchiveTrail label={tag} />
      <h1 class="page-title">Posts tagged <span class="tag-name">#{tag}</span></h1>
      <p class="page-lede">{posts.length} post{posts.length === 1 ? '' : 's'}</p>
    </header>
    {posts.length > 0 ? (
      <ul class="post-list">{posts.map(p => <PostRow post={p} stats={stats} />)}</ul>
    ) : (
      <ArchiveEmpty title="No posts found for this tag" description="Browse the archive to find another topic." />

    )}
  </div>
</Base>
