---
import Base from '../layouts/Base.astro';
import {ArchiveEmpty, ArchiveTrail} from '../components/react/ArchiveNavigation';
Astro.response.status = 404;
---
<Base title="Page not found" description="The requested page could not be found." url={Astro.url.pathname} noIndex>
  <div class="container page">
    <ArchiveTrail label="Page not found" />
    <ArchiveEmpty title="Page not found" description="This address may have moved. The writing archive lists every published article." page />
  </div>
</Base>
