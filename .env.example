# Optional: PostgreSQL connection string for production deployments.
# When omitted, the blog automatically uses local JSON storage in ./data/
# DATABASE_URL=postgresql://blog_user:password@localhost:5432/blog_db

# Optional: Local or cluster Ollama URL & model for AI comment summaries and AI usernames
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:latest

# Server port
PORT=3000
NODE_ENV=development
