# Optional: PostgreSQL connection string for production deployments.
# When omitted, the blog automatically uses local JSON storage in ./server/data/
# DATABASE_URL=postgresql://blog_user:password@localhost:5432/blog_db

# Set true when the database schema has already been provisioned for a DML-only runtime role.
# BLOG_SCHEMA_MANAGED_EXTERNALLY=true

# Optional: Local or cluster Ollama URL & model for AI comment summaries and AI usernames
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:latest

# Optional: Gotify push notifications for the feedback form
# GOTIFY_URL=http://localhost:8080
# GOTIFY_TOKEN=

# Server port (the container image sets PORT=80)
PORT=3000
NODE_ENV=development
